# Keep text files identical on Windows, macOS and Linux: LF in the repository
# and in the working tree. Without this, a Windows checkout can rewrite every
# line ending and show the whole repository as modified.
* text=auto eol=lf

# Binary assets: never transform these.
*.png binary
*.jpg binary
*.jpeg binary
*.pdf binary
*.zip binary
*.ico binary
*.woff binary
*.woff2 binary
